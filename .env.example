# ========================
# API Keys
# ========================
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""

# ========================
# Provider Base URLs
# ========================
DEEPSEEK_BASE_URL_ANTHROPIC="https://api.deepseek.com/anthropic"
DEEPSEEK_BASE_URL_OPENAI="https://api.deepseek.com"

# ========================
# Custom Providers
# ========================
# Add one ENV var per custom provider. The value is the actual API key;
# the WebUI / CLI will reference this var by NAME (e.g. MY_PROVIDER_API_KEY).
# Example:
# MY_PROVIDER_API_KEY="sk-..."
# ANOTHER_PROVIDER_API_KEY="sk-..."

# ========================
# Server Configuration
# ========================
PORT=8082
HOST=127.0.0.1

# ========================
# Agent Workspace
# ========================
WORKSPACE="./.agent-workspace"
ALLOWED_DIRECTORIES=""
